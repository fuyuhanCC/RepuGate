{
  "name": "repugate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --filter @repugate/web build",
    "dev": "pnpm --parallel --filter @repugate/api --filter @repugate/web dev",
    "dev:api": "pnpm --filter @repugate/api dev",
    "dev:web": "pnpm --filter @repugate/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
