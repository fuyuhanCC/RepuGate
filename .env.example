# Fixture mode remains enabled regardless of these settings. Leave this false
# for the deterministic Presentation demo.
REPUGATE_LIVE_ERC8004=false

# Required only when REPUGATE_LIVE_ERC8004=true.
# Official Base Sepolia ERC-8004 registry addresses are listed in:
# https://github.com/erc-8004/erc-8004-contracts
ERC8004_CHAIN_ID=84532
ERC8004_RPC_URL=https://sepolia.base.org
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Replace these values with the Agent and endpoint you want to inspect. The
# endpoint must appear in that Agent's ERC-8004 registration file.
ERC8004_AGENT_ID=1
ERC8004_SERVICE_ENDPOINT=https://agent.example/services/inference

# Set this to the registry deployment block, or another block that still
# includes the complete feedback history required for the selected Agent.
ERC8004_FEEDBACK_FROM_BLOCK=0

# Required only when the Agent uses an ipfs:// registration URI.
ERC8004_IPFS_GATEWAY=https://ipfs.io
